            "agenda_item_number": "4.1",
            "title": "French Language Services Advisory Committee Mid-Term Report 2023-2026",
            "attachments": [],
            "description": "",
            "minutes": "Melanie Blais, Committee Coordinator, Council and Committee Services, provided an overview of the French Language Services Advisory Committee's mid-term report. Robert Tremblay, Program Manager, Council and Committee Services answered questions from the Committee.\nLinda Savard et Marcel Morin, representatives of the Maison de la Francophonie d\u2019Ottawa, spoke before the Committee and provided comments on the items relating to the Recreational, Cultural and Facility Services as well as the Community and Social Services Departments",
            "motions": [
              {
                "premotion_text": "",
                "motion_number": "",
                "motion_moved_by": "",
                "motion_seconded_by": "",
                "motion_text": "Recommendation\nThat the French Language Services Advisory Committee approve its mid-term report, and recommend that the Finance and Corporate Services Committee receive the report.",
                "motion_votes": {},
                "dissent_voters": [],
                "motion_result": "Carried",
                "post_motion_text": ""
              }
            ]
          },
