          {
            "agenda_item_number": "6.1",
            "title": "O-Train Operations Transition to Push-Button Doors",
            "attachments": [],
            "description": "",
            "minutes": "",
            "motions": [
              {
                "premotion_text": "",
                "motion_number": "",
                "motion_moved_by": "",
                "motion_seconded_by": "",
                "motion_text": "Report Recommendation(s)\nThat the Accessibility Advisory Committee receive the presentation and provide feedback as appropriate.",
                "motion_votes": {},
                "dissent_voters": [],
                "motion_result": "Received",
                "post_motion_text": ""
              },
              {
                "premotion_text": "",
                "motion_number": "2024-11-01",
                "motion_moved_by": "Wayne Antle",
                "motion_seconded_by": "",
                "motion_text": "WHEREAS the Accessibility Advisory Committee (AAC) has received a presentation from staff that proposes changing service on the Confederation Line of the O-Train such that the doors will no longer open automatically; and\nWHEREAS the AAC has heard from public Delegations, including persons who are blind or have sight loss, along with its own members, and that the proposed change would introduce a barrier for people with disabilities;\nTHEREFORE BE IT RESOLVED that the AAC recommends that City Council reject the proposed change and that O-Train doors on the Confederation Line continue to open automatically.",
                "motion_votes": {},
                "dissent_voters": [],
                "motion_result": "Carried",
                "post_motion_text": ""
              }
            ]
          }
        ]
      },
