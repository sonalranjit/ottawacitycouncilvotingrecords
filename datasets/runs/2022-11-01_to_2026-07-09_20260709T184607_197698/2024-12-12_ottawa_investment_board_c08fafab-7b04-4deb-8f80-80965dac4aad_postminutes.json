            "agenda_item_number": "6.1",
            "title": "City of Ottawa Outsourced Chief Investment Officer Report - In Camera",
            "attachments": [],
            "description": "The Ottawa Investment Board resolved in camera at 9:31 am\u00a0The Ottawa Investment Board resumed in open session at 11:21 am.\u00a0\nUpon resuming in open session, Chair Rogers advised that the Ottawa Investment Board just met in camera pursuant to the Ottawa Investment Board Procedure By-law as follows:\u00a0\nDuring the closed session, no votes were taken other than procedural motions and/or directions to staff.\u202f\u00a0",
            "minutes": "",
            "motions": [
              {
                "premotion_text": "",
                "motion_number": "2024-03-01",
                "motion_moved_by": "H. Saikali",
                "motion_seconded_by": "",
                "motion_text": "BE IT RESOLVED THAT the Ottawa Investment Board resolve in camera pursuant to Subsection 24(i) of the Ottawa Investment Board Procedure By-law, as the subject matter relates to \u201ctechnical, commercial or financial information, supplied in confidence to the Board, which, if disclosed, could reasonably be expected to prejudice significantly the competitive position or interfere significantly with the contractual or other negotiations of a person, group of persons, or organization\u201d, at which time a presentation will be provided on the long list of candidates for Outsourced Chief Investment Officer, which is confidential and will not be reported out.",
                "motion_votes": {},
                "dissent_voters": [],
                "motion_result": "Carried",
                "post_motion_text": ""
              },
              {
                "premotion_text": "",
                "motion_number": "",
                "motion_moved_by": "",
                "motion_seconded_by": "",
                "motion_text": "Recommendation:That the Ottawa Investment Board receive the confidential report from Eckler Limited and proceed with the next steps in the selection process for the Outsourced Chief Investment Officer.",
                "motion_votes": {},
                "dissent_voters": [],
                "motion_result": "Received",
                "post_motion_text": ""
              }
            ]
          }
