            "agenda_item_number": "7.1",
            "title": "Presentation for Information: Board Insurance (In-Camera)",
            "attachments": [],
            "description": "",
            "minutes": "The Board resolved in camera at 10:41 am.The Board resumed in open session at 11:15 am.\nUpon resuming in open session, Chair Rogers advised that the Board just met in camera pursuant to the Ottawa Investment Board Procedure By-law, as follows: Subsection 26, educating or training the Members.\nDuring the closed session, no votes were taken other than procedural motions and/or directions to staff.",
            "motions": [
              {
                "premotion_text": "",
                "motion_number": "2025-05-01",
                "motion_moved_by": "A. E. Harvey",
                "motion_seconded_by": "",
                "motion_text": "BE IT RESOLVED THAT the Ottawa Investment Board resolve to move in camera pursuant to Subsection 26 of the Ottawa Investment Board Procedure By-law, as the subject matter relates to \u201ceducating or training the Members\u201d, and at which time a presentation will be provided, regarding insurance for the Board Members, which is confidential and will not be reported out.",
                "motion_votes": {},
                "dissent_voters": [],
