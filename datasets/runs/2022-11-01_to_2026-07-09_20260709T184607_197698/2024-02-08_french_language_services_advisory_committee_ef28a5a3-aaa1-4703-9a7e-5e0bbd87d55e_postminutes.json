                "motion_number": "",
                "motion_moved_by": "",
                "motion_seconded_by": "",
                "motion_text": "Recommendation\nThat the French Language Services Advisory Committee recommend that the Finance and Corporate Services Committee recommend that City Council approve the French Language Services Advisory Committee\u2019s 2024-2026 work plan.",
