            "title": "RCMP Special Constable Appointments and Delegated Authority: 1 Million March 4 Children Events",
            "attachments": [
              {
                "link": "https://pub-ottawa.escribemeetings.com/filestream.ashx?DocumentId=157248",
                "attachment_title": "9- RCMP - Special Constable - 1 Million March 4 Children Event October 2023.pdf"
