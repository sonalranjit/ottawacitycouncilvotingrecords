          {
            "agenda_item_number": "6.2",
            "title": "Kitchissippi Parking Study Update",
            "attachments": [
              {
                "link": "https://pub-ottawa.escribemeetings.com/filestream.ashx?DocumentId=254906",
                "attachment_title": "Report - Kitchissippi Parking Study.pdf"
              },
              {
                "link": "https://pub-ottawa.escribemeetings.com/filestream.ashx?DocumentId=254907",
                "attachment_title": "Document 1 - Kitchissippi Parking Study.pdf"
              }
            ],
            "description": "File No.\u00a0 ACS2024-PWD-RPS-0003 - Kitchissippi (15) Bay (7)",
            "minutes": "Scott Caldwell, Manager, Parking Services, Public Works Department spoke to a presentation, a copy of which is held on file with Office of the City Clerk, and answered questions from the Committee.\nPrior to the receipt of public delegations, a Motion (referenced below), was introduced by Councillor Leiper (moved by Councillor Johnson).\nThe Committee heard from the following delegation:\nThe following written submission was received by and is filed with the Office of the City Clerk and was distributed to Committee members.\nFollowing questions to the delegations and to staff, and at the conclusion of Committee discussions, the Motion introduced earlier was voted upon as follows\u00a0:",
            "motions": [
              {
                "premotion_text": "",
                "motion_number": "",
                "motion_moved_by": "",
                "motion_seconded_by": "",
                "motion_text": "Report Recommendation(s)\nThat Transportation Committee Recommend Council:",
                "motion_votes": {},
                "dissent_voters": [],
                "motion_result": "Carried",
                "post_motion_text": ""
              },
              {
                "premotion_text": "",
                "motion_number": "2024-13-01",
                "motion_moved_by": "L. Johnson",
                "motion_seconded_by": "",
                "motion_text": "WHEREAS the recommendation of Kitchissippi Parking Study Update report ACS2024-PWD-RPS-0003 includes the implementation of paid on-street parking, including alongthe main street corridor on Somerset Street West, Wellington Street West and much of Richmond Road in Kitchissippi ward; andWHEREAS the recommended implementation is in alignment with the Rate SettingGuidelines within the Municipal Parking Management Strategy approved by Council; and,WHEREAS the businesses located on these streets have become reliant on theavailability of street parking in proximity to their location for staff and owner parking; andWHEREAS concerns have been raised by businesses related to accommodating parking for employees when paid parking is implemented which coincides with a requirement to find alternatives to private vehicle parking, including using alternatemodes of transportation; and,WHEREAS Westboro is not yet served by light rail, and will not be served by light rail until at least the end of 2026;THEREFORE BE IT RESOLVED that the commencement of paid street parking in the areas recommended in this report not begin until the Stage 2 extension of light rail enters revenue service.",
                "motion_votes": {
                  "for": {
                    "councillors": [
                      "M. Luloff",
                      "G. Darouze",
                      "J. Bradley"
                    ],
                    "count": 3
                  },
                  "against": {
                    "councillors": [
                      "L. Dudas",
                      "G. Gower",
                      "T. Tierney",
                      "L. Johnson",
                      "S. Devine",
                      "A. Troster",
                      "S. Desroches",
                      "W. Lo"
                    ],
                    "count": 8
                  }
                },
                "dissent_voters": [],
                "motion_result": "Lost (3 to 8)",
                "post_motion_text": ""
              }
            ]
          },
